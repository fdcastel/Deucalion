<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Deucalion.Api is only ever run through `dotnet run`/`dotnet watch` or hosted by
         Deucalion.Service. The apphost would otherwise be copied into the Service's AOT
         publish output as a Deucalion.Api.exe that has no Deucalion.Api.dll to load. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deucalion.Application\Deucalion.Application.csproj" />
    <ProjectReference Include="..\Deucalion.Storage\Deucalion.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hosted services and the broadcaster are internal on purpose; the test project
         needs to reach them without widening the public surface. -->
    <InternalsVisibleTo Include="Deucalion.Tests" />
  </ItemGroup>

</Project>
