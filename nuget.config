<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Without <clear /> this file is a no-op: sources merge with the user-level config,
         so a machine-local private feed would silently take part in restores. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
